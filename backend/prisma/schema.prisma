generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  status    Boolean  @default(true) // true = active, false = inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Enrollment profile ---------------------------------------------------
  // All nullable so every pre-existing row stays valid. Postgres permits
  // multiple NULLs under a UNIQUE constraint, so legacy users without an
  // identifier do not collide with each other.
  //
  // niatId/universityName apply to STUDENT, employeeId to INSTRUCTOR. They live
  // on User rather than in separate tables because the app has always modelled
  // all three roles as one User row; splitting them now would break every
  // existing relation, query and role filter.
  niatId         String? @unique
  universityName String?
  employeeId     String? @unique

  // Tech stack the user is enrolled under / teaches. Nullable and SetNull so
  // deleting a TechStack can never cascade into deleting people.
  techStackId String?
  techStack   TechStack? @relation("UserTechStack", fields: [techStackId], references: [id], onDelete: SetNull)

  // --- Password lifecycle ---------------------------------------------------
  // Defaults to true so newly enrolled users are forced through the one-time
  // password change. The baseline migration backfills existing rows to false —
  // they already chose their own passwords and must not be locked out.
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  /**
   * Stamped once, on the user's very first successful login.
   */
  firstLoginAt       DateTime?

  // --- Credential delivery tracking -----------------------------------------
  // Records what happened to the enrollment email carrying the temporary
  // password. Enrollment never depends on this — the account exists whether or
  // not the mail left the building — but an admin needs to know when it didn't.
  credentialStatus        CredentialStatus @default(PENDING)
  credentialSentAt        DateTime?
  credentialFailureReason String?
  credentialRetryCount    Int              @default(0)
  credentialLastRetryAt   DateTime?

  studentBatches    StudentBatch[]
  instructorBatches InstructorBatch[]
  sessions          Session[]         @relation("InstructorSessions")
  attendances       Attendance[]
  progressRecords   StudentProgress[]

  enrollmentEvents EnrollmentEvent[] @relation("EnrollmentEventSubject")
  actedEvents      EnrollmentEvent[] @relation("EnrollmentEventActor")

  // --- LMS back-relations (Phase 1). Prisma requires these; they emit no SQL.
  authoredPaths         LearningPath[]          @relation("PathAuthor")
  authoredModules       Module[]                @relation("ModuleAuthor")
  authoredContents      Content[]               @relation("ContentAuthor")
  editedContents        Content[]               @relation("ContentEditor")
  uploadedAssets        MediaAsset[]            @relation("AssetUploader")
  contentProgress       ContentProgress[]       @relation("StudentContentProgress")
  authoredNotifications Notification[]          @relation("NotificationAuthor")
  notifications         NotificationRecipient[] @relation("NotificationRecipient")

  // --- LMS back-relations (Phase 3).
  authoredAssignments Assignment[] @relation("AssignmentAuthor")
  submissions         Submission[] @relation("StudentSubmissions")
  gradedSubmissions   Submission[] @relation("SubmissionGrader")
  authoredQuizzes     Quiz[]       @relation("QuizAuthor")
  quizAttempts        Attempt[]    @relation("StudentAttempts")

  @@index([role])
  @@index([techStackId])
  @@index([status, role])
  @@index([credentialStatus])
  @@index([mustChangePassword])
}

enum CredentialStatus {
  /**
   * Enrolled (or reset without email); no delivery attempted or concluded.
   */
  PENDING
  /**
   * The original enrollment credential email was accepted by the transport.
   */
  SENT
  /**
   * Delivery failed; credentialFailureReason explains why.
   */
  FAILED
  /**
   * A RESET credential email was delivered — distinguishes a reset from the
   * original enrollment, which `SENT` alone could not express.
   */
  RESET_SENT
}

enum EnrollmentEventType {
  ENROLLED
  /**
   * A temporary password was minted (enrollment or reset). Always precedes a
   * CREDENTIAL_SENT / CREDENTIAL_FAILED pair, or stands alone when the admin
   * chose to deliver the credential manually.
   */
  CREDENTIAL_GENERATED
  CREDENTIAL_SENT
  CREDENTIAL_FAILED
  /**
   * DEPRECATED — no longer written.
   * Retained because PostgreSQL cannot drop an enum value that existing rows
   * may reference, and removing it would break any database where the previous
   * migration has already been applied. The blocked-resend workflow it recorded
   * was replaced by "Reset & Send New Credentials", which performs the reset
   * directly instead of refusing and redirecting.
   */
  CREDENTIAL_RESEND_BLOCKED
  PASSWORD_RESET
  PASSWORD_CHANGED
  FIRST_LOGIN
  ACTIVATED
  DEACTIVATED
  PROFILE_UPDATED
  /// LMS Phase 1: batch membership lifecycle.
  BATCH_ASSIGNED
  BATCH_TRANSFERRED
  BATCH_REMOVED
}

/**
 * Append-only audit trail for everything that happens to an account's
 * credentials and access.
 * `actorId` is the admin who performed the action, and is NULL for events the
 * user causes themselves (first login, their own password change) and for
 * system-generated events (email delivery outcomes). It is SetNull on delete so
 * removing an admin can never erase the history of what they did.
 */
model EnrollmentEvent {
  id      String              @id @default(uuid())
  userId  String
  type    EnrollmentEventType
  /**
   * Human-readable context: failure reason, deactivation reason, etc.
   */
  detail  String?
  actorId String?

  createdAt DateTime @default(now())

  user  User  @relation("EnrollmentEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("EnrollmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt])
}

model TechStack {
  id   String @id @default(uuid())
  name String @unique

  // --- LMS additions (Phase 1). All nullable/defaulted: existing rows stay valid.
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches         Batch[]
  progressRecords StudentProgress[]
  users           User[]            @relation("UserTechStack")
  learningPaths   LearningPath[]
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Batch {
  id          String    @id @default(uuid())
  name        String
  techStackId String
  techStack   TechStack @relation(fields: [techStackId], references: [id])

  // --- LMS additions (Phase 1) ---
  // `techStackId` is deliberately KEPT even though LearningPath also carries it:
  // it is required by the live POST/PATCH /batches endpoints and the batch form.
  // The service layer enforces batch.learningPath.techStackId === batch.techStackId.
  //
  // Nullable rather than required: existing batches have no path until the M1
  // backfill runs, and a nullable FK that is always populated by the write paths
  // is safer than a NOT NULL that can fail a deploy.
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Restrict)

  code      String?     @unique
  startDate DateTime?
  endDate   DateTime?
  status    BatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  studentBatches    StudentBatch[]
  instructorBatches InstructorBatch[]
  sessions          Session[]
  contents          Content[]
  notifications     Notification[]
  assignments       Assignment[]
  quizzes           Quiz[]

  @@index([techStackId])
  @@index([learningPathId])
  @@index([status])
}

model StudentBatch {
  studentId  String
  batchId    String
  /// When this membership began. Set on assignment and on transfer, so the
  /// timeline of a student's batch history is reconstructable from the audit
  /// trail plus this timestamp.
  assignedAt DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([studentId, batchId])
  /// One active batch per student. Assigning a student who already belongs to
  /// another batch is a MOVE, performed transactionally by
  /// BatchMembershipService — never an insert that violates this.
  @@unique([studentId])
  @@index([studentId])
  @@index([batchId])
}

model InstructorBatch {
  instructorId String
  batchId      String

  instructor User  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  batch      Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([instructorId, batchId])
  @@index([instructorId])
  @@index([batchId])
}

model Session {
  id             String        @id @default(uuid())
  title          String
  description    String?
  batchId        String
  instructorId   String
  googleEventId  String?
  googleMeetLink String?
  meetingCode    String?
  startTime      DateTime
  endTime        DateTime
  status         SessionStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  batch      Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor User  @relation("InstructorSessions", fields: [instructorId], references: [id], onDelete: Cascade)

  attendances Attendance[]

  @@index([batchId])
  @@index([instructorId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  remarks   String?
  markedBy  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

enum ProgressLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Instructor's MANUAL proficiency assessment. Deliberately untouched by the
/// LMS — objective learning progress lives in ContentProgress. The dashboard
/// shows both, clearly labelled as different things.
model StudentProgress {
  id          String        @id @default(uuid())
  studentId   String
  techStackId String
  progress    Int           @default(0)
  level       ProgressLevel @default(BEGINNER)
  notes       String?
  lastUpdated DateTime      @default(now())

  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  techStack TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)

  @@unique([studentId, techStackId])
  @@index([studentId])
  @@index([techStackId])
}

// ===========================================================================
// LMS — Phase 1: curriculum, content, storage, progress
// ===========================================================================

enum LearningPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A versioned curriculum for a tech stack — "MERN 2026", "MERN 2027".
///
/// Cloning a path deep-copies its modules and content, which is what lets the
/// curriculum evolve without a single migration. Batches pin to a version, so
/// publishing a new one never disturbs a cohort already running the old one.
model LearningPath {
  id          String             @id @default(uuid())
  techStackId String
  name        String
  version     String
  description String?
  status      LearningPathStatus @default(DRAFT)
  /// The path new batches receive unless an admin picks another.
  isDefault   Boolean            @default(false)

  /// Provenance when this path was cloned from another.
  clonedFromId String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  techStack  TechStack      @relation(fields: [techStackId], references: [id], onDelete: Cascade)
  clonedFrom LearningPath?  @relation("PathLineage", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     LearningPath[] @relation("PathLineage")
  createdBy  User?          @relation("PathAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  modules     Module[]
  contents    Content[]
  assignments Assignment[]
  quizzes     Quiz[]
  /// Restrict: refuse to delete a path a cohort is actively running.
  batches     Batch[]

  @@unique([techStackId, version])
  @@index([techStackId, status])
}

enum ModuleDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Module {
  id             String  @id @default(uuid())
  learningPathId String
  name           String
  description    String?
  position       Int     @default(0)
  isVisible      Boolean @default(true)

  // --- Descriptive metadata. NOT enforced (approved decision 7). ---
  estimatedDurationMinutes Int?
  difficulty               ModuleDifficulty?

  /// Lineage root, stable across clones. Two modules are "the same module in a
  /// different curriculum version" iff they share an originId. This is what
  /// lets a transferred student's completed work count toward an equivalent
  /// module in their new Learning Path.
  ///
  /// Set to the module's own id on first creation; carried unchanged by clones.
  originId String?

  /// Card art for the module grid. A MediaAsset rather than a URL string, so
  /// thumbnails go through the same signed-upload and deletion path as every
  /// other file — no second storage code path.
  thumbnailAssetId String?

  /// Reserved for AI Tutor / AI quiz generation. Unstructured so AI metadata
  /// never requires a migration.
  aiMetadata  Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ModuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  /// SetNull, matching Content.asset: deleting the image degrades the card to a
  /// placeholder rather than blocking the delete or cascading away the module.
  thumbnail    MediaAsset?  @relation("ModuleThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  contents      Content[]
  assignments   Assignment[]
  quizzes       Quiz[]
  prerequisites ModulePrerequisite[] @relation("ModuleRequires")
  requiredBy    ModulePrerequisite[] @relation("ModuleRequiredBy")

  @@index([learningPathId, position])
  @@index([learningPathId, isVisible])
  @@index([originId])
}

/// Prerequisite graph. Stored as a relation rather than free text so it can be
/// ENFORCED later by adding one check to the visibility resolver — with no
/// schema change. Today it is displayed and nothing more.
model ModulePrerequisite {
  moduleId       String
  prerequisiteId String

  module       Module @relation("ModuleRequires", fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisite Module @relation("ModuleRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([moduleId, prerequisiteId])
  @@index([prerequisiteId])
}

enum ContentType {
  PDF
  PPT
  DOCX
  GITHUB_REPO
  RECORDING
  LINK
  VIDEO
  /// Supplementary reading — carries either a file or a URL, unlike every other
  /// type which requires exactly one. Appended last: reordering an enum
  /// rewrites existing rows' meaning.
  REFERENCE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VisibilityScope {
  LEARNING_PATH
  BATCH
}

model Content {
  id             String        @id @default(uuid())
  moduleId       String
  /// Denormalised one hop up from Module. Keeps the visibility query — run on
  /// every student page load — free of a join.
  learningPathId String
  title          String
  description    String?
  type           ContentType
  status         ContentStatus @default(DRAFT)
  position       Int           @default(0)

  // --- Visibility ---
  scope       VisibilityScope @default(LEARNING_PATH)
  batchId     String?
  /// When set, this batch-scoped item REPLACES the referenced global item for
  /// its batch. Null on a batch item means "inherit global and add this too".
  overridesId String?         @unique

  /// NULL = released immediately. Evaluated lazily at read time — no scheduler.
  releaseAt DateTime?

  // --- Payload: exactly one is populated, per `type` ---
  assetId     String?
  externalUrl String?

  /// Lineage root, stable across clones. See Module.originId.
  originId String?

  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  asset        MediaAsset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  overrides    Content?     @relation("ContentOverride", fields: [overridesId], references: [id], onDelete: SetNull)
  overriddenBy Content?     @relation("ContentOverride")
  createdBy    User?        @relation("ContentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("ContentEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  progress ContentProgress[]

  @@index([moduleId, status, position])
  @@index([learningPathId, status])
  @@index([batchId])
  @@index([releaseAt])
  @@index([originId])
}

enum StorageProvider {
  CLOUDINARY
  SUPABASE
}

/// Provider-agnostic file record. Content references an asset, never a raw URL,
/// so the storage provider can change without touching content rows.
model MediaAsset {
  id               String          @id @default(uuid())
  provider         StorageProvider @default(CLOUDINARY)
  /// The provider's ACTUAL identifier, as returned by the upload response —
  /// never the key we pre-signed.
  ///
  /// Cloudinary appends the file extension to `public_id` for `raw` assets
  /// (`…/notes-ab12.docx`) but not for `image` assets (`…/notes-ab12`). Storing
  /// the signed key instead made every raw delete return `"result":"not found"`.
  providerKey      String
  url              String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  /// Cloudinary's classification: `image` | `raw` | `video`.
  ///
  /// Required to delete: the destroy endpoint is
  /// `/v1_1/<cloud>/<resourceType>/destroy` and rejects `auto` outright with
  /// "Invalid resource type 'auto'".
  ///
  /// Verified empirically — note PDF is classified `image`, not `raw`, because
  /// Cloudinary can render and transform PDFs. Deriving this from mimeType
  /// would encode that quirk as an assumption; storing what the provider
  /// actually said cannot drift.
  resourceType     String?
  /// Cloudinary's normalised format (`pdf`, `png`, `jpg`). Absent for `raw`
  /// assets, so nullable by nature rather than by caution.
  format           String?
  checksum         String?
  uploadedById     String?
  createdAt        DateTime        @default(now())

  moduleThumbnails Module[] @relation("ModuleThumbnail")

  uploadedBy User?     @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  contents   Content[]

  /// Restrict on the far side — see Submission.asset. Student work is never
  /// silently detached from its file.
  submissions Submission[] @relation("SubmissionArtifact")

  @@unique([provider, providerKey])
  @@index([uploadedById])
}

/// OBJECTIVE consumption tracking — what the student actually opened.
/// Distinct from StudentProgress, which is the instructor's subjective rating.
model ContentProgress {
  id        String @id @default(uuid())
  studentId String
  contentId String

  /// Split counters power analytics without an unbounded event-log table.
  viewCount     Int @default(0)
  downloadCount Int @default(0)
  openCount     Int @default(0)

  firstViewedAt DateTime  @default(now())
  /// Drives the "Continue Learning" widget.
  lastViewedAt  DateTime  @default(now())
  completedAt   DateTime?
  secondsSpent  Int       @default(0)

  student User    @relation("StudentContentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId, lastViewedAt])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Notifications — table created in Phase 1 so Batch's back-relation resolves.
// Fan-out and delivery tiers arrive in Phase 3 (M4).
// ---------------------------------------------------------------------------

enum NotificationType {
  NOTES_UPLOADED
  VIDEO_UPLOADED
  RECORDING_UPLOADED
  ASSIGNMENT_PUBLISHED
  QUIZ_PUBLISHED
  PROJECT_PUBLISHED
  ASSIGNMENT_EVALUATED
  PROJECT_EVALUATED
  QUIZ_EVALUATED
  DUE_DATE_REMINDER
  UPCOMING_SESSION
  ANNOUNCEMENT
  BATCH_TRANSFERRED
}

enum NotificationAudience {
  INDIVIDUAL
  BATCH
  LEARNING_PATH
  TECH_STACK
  ROLE
  BROADCAST
}

/// TIER 1 — the event. Written ONCE regardless of audience size.
model Notification {
  id       String               @id @default(uuid())
  type     NotificationType
  audience NotificationAudience
  title    String
  body     String?
  linkUrl  String?

  /// Soft reference to the subject. Generic by design: a new notifiable thing
  /// needs an enum value and nothing else.
  entityType String?
  entityId   String?

  batchId        String?
  learningPathId String?
  techStackId    String?
  targetRole     Role?

  createdById String?
  createdAt   DateTime @default(now())

  batch      Batch?                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy  User?                   @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type, createdAt])
  @@index([batchId])
}

/// TIER 2 — one row per person per event, carrying read state.
///
/// The two-tier split is what keeps a batch announcement to 200 students a
/// single Notification row plus 200 thin rows, rather than 200 duplicated
/// copies of the title and body. Fan-out is written once at publish time so the
/// student's unread query is a plain indexed lookup, never a union over
/// batch/path/stack/role rules evaluated per request.
model NotificationRecipient {
  id             String @id @default(uuid())
  notificationId String
  userId         String

  /// NULL until opened. Indexed with userId to make the unread badge a count
  /// over one index rather than a scan.
  readAt DateTime?

  /// Delivery outcome for the email tier. Email failure never blocks the
  /// in-app notification — the same isolation the enrollment flow uses.
  emailSentAt        DateTime?
  emailFailureReason String?

  createdAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ===========================================================================
// LMS — Phase 3, Module 1: assignments
// ===========================================================================

/// Graded work attached to a module.
///
/// Deliberately NOT a `ContentType`. Content is material a student consumes and
/// whose progress is a completion flag; an assignment is work a student returns,
/// carrying a deadline, a mark and a submission of its own. Modelling it as
/// content would have meant nullable deadline/maxMarks columns on every PDF row
/// and a `type == ASSIGNMENT` branch in each of the Phase 1/2 content paths.
///
/// Visibility mirrors Content exactly — `scope` + `batchId`, resolved by the
/// shared resolver in visibility.service.ts — so a batch can be set work the
/// rest of the cohort never sees, using the rule that already exists.
model Assignment {
  id       String @id @default(uuid())
  moduleId String
  /// Denormalised one hop up from Module, for the same reason Content carries
  /// it: the student-facing visibility query runs on every page load and should
  /// not need a join to know which curriculum an item belongs to.
  learningPathId String

  title String
  /// Rich text (HTML from the authoring editor). Stored as-is and escaped at
  /// every render site — the notification e-mail path already escapes.
  description String
  maxMarks    Int
  deadline    DateTime

  /// Draft/publish rather than Content's three-state `status`: an assignment is
  /// never "archived" — it is either being written or it is set. Publishing is
  /// the event students are notified about, and the transition is one-way per
  /// notification (see AssignmentService.setPublished).
  isPublished Boolean   @default(false)
  /// Stamped on the false -> true transition. Distinguishes "drafted long ago,
  /// published today" from "created today", which `createdAt` alone cannot.
  publishedAt DateTime?

  // --- Visibility. Same two fields, same meaning, as Content. ---
  scope   VisibilityScope @default(LEARNING_PATH)
  batchId String?

  /// Whether a student may replace work they have already handed in.
  ///
  /// Per-assignment rather than global: a take-home project wants revisions, a
  /// timed test does not. Defaults to true because refusing a second attempt is
  /// the surprising behaviour, and the existing rows created before this column
  /// existed were all set under that assumption.
  allowResubmission Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// SetNull, matching every other authored LMS row: removing the admin who set
  /// the work must not delete the work.
  createdBy    User?        @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  submissions Submission[]

  @@index([moduleId, isPublished, deadline])
  @@index([learningPathId, isPublished])
  @@index([batchId])
  @@index([deadline])
}

/// A student's handed-in work for one assignment.
///
/// THE FILE IS A MediaAsset REFERENCE, not inline publicId/url/resourceType
/// columns. That is the single most important decision in this model, and it
/// was anticipated in Phase 1 — storage.service.ts already documents "a
/// submission artifact is Restrict, and student work is never silently detached
/// from its file".
///
/// Copying the provider fields onto this table would have meant a second file
/// record with a second lifecycle: a second place to remember that `public_id`
/// must be the value Cloudinary RETURNED (raw assets carry the extension), a
/// second place to store `resourceType` (destroy rejects `auto`, and PDF is
/// `image`, not `raw`), and a second delete path that would have to re-learn
/// both. The API still returns publicId/resourceType/format/fileUrl — they are
/// read through the relation, so the response shape is unchanged while the
/// storage rules stay in exactly one place.
///
/// One row per (assignment, student): resubmission REPLACES the artifact rather
/// than appending an attempt, which is what makes "the submission" for grading
/// unambiguous. `attemptCount` keeps the fact that it happened.
model Submission {
  id           String @id @default(uuid())
  assignmentId String
  studentId    String

  assetId String

  submittedAt DateTime @default(now())

  /// Whether `submittedAt` fell after the assignment's deadline.
  ///
  /// Stored, not derived — but kept truthful: extending a deadline recomputes
  /// it for every affected submission (see AssignmentService.update). A stored
  /// flag that silently disagreed with the deadline it was derived from would
  /// be worse than either alternative, so the write path owns keeping it right.
  isLate Boolean

  /// How many times this student has handed in. The only trace a resubmission
  /// happened, since the previous artifact is replaced rather than kept.
  attemptCount Int @default(1)

  // --- Evaluation. Null until an instructor marks the work. ---
  marks      Int?
  feedback   String?
  gradedAt   DateTime?
  gradedById String?

  /// RESTRICT, not Cascade.
  ///
  /// Cascade was the original choice and it was wrong: deleting one assignment
  /// silently destroyed every submission against it — the files, the marks and
  /// the feedback — and orphaned the Cloudinary objects somewhere even the
  /// admin orphan report could not see, because that report only lists assets
  /// that still have a MediaAsset row.
  ///
  /// AssignmentService.remove and ModuleService.remove both refuse this in the
  /// application layer with a readable message, and they remain the paths a
  /// user actually meets. This constraint is the backstop underneath them: a
  /// raw SQL delete, a Prisma Studio click, a seed script or a future code path
  /// that forgets the guard now hits a foreign-key violation instead of
  /// quietly erasing student work.
  ///
  /// Matches `asset` below, which has been Restrict since Phase 3 M2 for the
  /// same reason — student work is never silently detached from its evidence.
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  /// Restrict: deleting the file out from under submitted work is refused
  /// outright. Content uses SetNull because a missing file degrades a card to a
  /// placeholder; a submission with no artifact is not degraded, it is evidence
  /// that has gone missing.
  asset      MediaAsset @relation("SubmissionArtifact", fields: [assetId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  /// One current submission per student per assignment.
  @@unique([assignmentId, studentId])
  @@index([assignmentId, isLate])
  @@index([studentId, submittedAt])
  @@index([assetId])
}

// ===========================================================================
// LMS — Phase 3, Module 3: quizzes
// ===========================================================================

/// A timed, auto-marked MCQ assessment attached to a module.
///
/// Visibility columns are IDENTICAL to Assignment's (`isPublished`, `scope`,
/// `batchId`, plus the denormalised `learningPathId`) — deliberately, so both
/// share one implementation in visibility.service.ts rather than two that
/// merely look alike.
model Quiz {
  id       String @id @default(uuid())
  moduleId String
  /// Denormalised one hop up from Module, matching Content and Assignment: the
  /// student-facing visibility query should not need a join to know which
  /// curriculum an item belongs to.
  learningPathId String

  title       String
  description String?
  /// Minutes. The attempt's own deadline is pinned at start time (see
  /// Attempt.expiresAt) so changing this never moves a running clock.
  timeLimit   Int

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // --- Visibility. Same two fields, same meaning, as Content and Assignment.
  scope   VisibilityScope @default(LEARNING_PATH)
  batchId String?

  /// How many completed attempts a student may make. NULL = unlimited.
  ///
  /// An Int rather than Assignment's `allowResubmission` boolean because a quiz
  /// is normally capped at a small number rather than switched on or off, and
  /// `maxAttempts = 1` already expresses the boolean's "off".
  maxAttempts Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("QuizAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  questions Question[]
  attempts  Attempt[]

  @@index([moduleId, isPublished])
  @@index([learningPathId, isPublished])
  @@index([batchId])
}

/// One multiple-choice question.
///
/// `correctAnswer` is the single most sensitive column in the LMS: leaking it
/// into a student-facing response hands out the whole answer key. It is
/// excluded by QUIZ_SELECT_STUDENT in quiz.service.ts and never selected on a
/// student path.
model Question {
  id       String @id @default(uuid())
  quizId   String
  question String

  /// The choices, as a JSON array of strings. Json rather than a child table
  /// because options have no identity of their own — they are never referenced,
  /// reordered independently, or queried across questions. The answer is stored
  /// as the option's VALUE, so a Json array is the whole model.
  options Json
  /// Must be one of `options`; enforced on every write in quiz.service.ts.
  correctAnswer String
  marks         Int @default(1)

  /// Render order. Without it Postgres is free to return questions in any
  /// order, and a quiz whose questions shuffle between page loads looks broken.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
}

/// One student's run at a quiz.
///
/// Created by `start` with no answers, completed by `submit`. That is why
/// `answers`, `score`, `totalMarks` and `submittedAt` are all nullable while
/// the attempt is open — an in-progress attempt has none of them, and modelling
/// them as required would mean inventing placeholder values that later read as
/// a real score of zero.
model Attempt {
  id        String @id @default(uuid())
  quizId    String
  studentId String

  /// `{ questionId: selectedOption }`, exactly as submitted. Kept so a mark can
  /// be explained back to the student rather than asserted.
  answers Json?

  /// Marked once, at submission. Stored rather than derived because the
  /// question set can legitimately change afterwards — `totalMarks` is the
  /// snapshot that keeps an old attempt's score meaningful against the quiz it
  /// was actually taken on. This is an evaluation record, not an aggregate.
  score      Int?
  totalMarks Int?

  startedAt DateTime @default(now())
  /// NULL while the attempt is open. The presence of this value is what makes
  /// "submitting without starting" and "submitting twice" both detectable.
  submittedAt DateTime?

  /// startedAt + the quiz's timeLimit, pinned at start.
  ///
  /// Stored, not computed on read: an admin editing `Quiz.timeLimit` mid-attempt
  /// must not move the clock under a student who is already running against it.
  expiresAt DateTime

  /// True when the server finalised an abandoned attempt at its expiry rather
  /// than the student submitting. NOT derivable — an auto-finalised attempt and
  /// one submitted at the last instant look identical otherwise, and the
  /// difference is exactly what explains a zero.
  autoSubmitted Boolean @default(false)

  /// RESTRICT, not Cascade.
  ///
  /// An attempt is a student's exam record: what they answered, when, and what
  /// it scored. Cascade meant deleting a quiz erased every one of them — the
  /// same defect Submission.assignmentId had, with the same fix.
  ///
  /// QuizService.remove already refuses while attempts exist, and gives a
  /// readable reason. This constraint is the backstop underneath it, for the
  /// raw SQL delete, the Prisma Studio click and the seed script that never go
  /// through the service.
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
  student User @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([studentId, submittedAt])
}
