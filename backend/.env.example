# Application
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Supabase / Postgres)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="1d"

# SMTP / Email Configuration (SMTP is the only email transport)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"                 # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"   # Gmail: 16-character App Password, not the account password

# Optional SMTP tuning (defaults shown)
# SMTP_SECURE="false"           # override TLS mode; defaults to true only on port 465
# SMTP_IP_FAMILY="4"            # 4 = force IPv4 (default), 6 = IPv6, 0 = auto
# SMTP_CONNECTION_TIMEOUT="15000"
# SMTP_GREETING_TIMEOUT="10000"
# SMTP_SOCKET_TIMEOUT="25000"
# SMTP_DEBUG="false"            # true = log the full SMTP handshake (no credentials)
# SMTP_STARTUP_DIAGNOSTICS="true"  # set to "false" to skip the boot-time verify() probe

# Google Workspace / OAuth (Calendar & Meet)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://YOUR_RENDER_BACKEND_URL/api/google/oauth/callback"
GOOGLE_REFRESH_TOKEN="your-refresh-token"
GOOGLE_CALENDAR_ID="primary"
